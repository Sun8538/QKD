# Flask Secret Key (Change this to a strong random string)
SECRET_KEY=quantum-secure-key-2024-iot-networks

# Application Base URL (Important for QR codes to work when scanned from phones)
# For development on local network, use your computer's local IP address
# Example: APP_BASE_URL=http://192.168.1.100:5000
# For production, use your actual domain
# Example: APP_BASE_URL=https://yourdomain.com
APP_BASE_URL=http://192.168.0.108:5000

# ==================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ==================================================
# To use Gmail:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password below (not your regular Gmail password)

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=code.saket@gmail.com
MAIL_PASSWORD=fhrldyroqqebkvtu
MAIL_DEFAULT_SENDER=code.saket@gmail.com

# ==================================================
# AZURE OPENAI CONFIGURATION
# ==================================================
# Get these credentials from Azure Portal:
# 1. Go to your Azure OpenAI resource
# 2. Click "Keys and Endpoint" in the left sidebar
# 3. Copy Endpoint URL and one of the Keys
# 4. Deployment name is what you named your model deployment

AZURE_OPENAI_ENDPOINT=https://qkd.services.ai.azure.com/api/projects/proj-default
AZURE_OPENAI_KEY=F5UezYgYaRAAmWN3ItMx1EWRF8s6p6Bt42ol3d0nN109YbsNhh4PJQQJ99CCACYeBjFXJ3w3AAAAACOGLrH3
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ==================================================
# QKD SETTINGS (Optional - defaults in config.py)
# ==================================================
# QKD_KEY_LENGTH=256
# KEY_REFRESH_INTERVAL=300
# KEY_EXPIRY_TIME=3600

# ==================================================
# IMPORTANT NOTES:
# ==================================================
# 
# 1. APP_BASE_URL: 
#    - For QR codes to work when scanned from phones, set this to your 
